    "/api/v1/sessions/{session_id}/recording/end": {
      "description": "Identity-bound end of the Session's own recording segment. The receipt separates STOP dispatch, parking evidence, Recorder drain, finalize proof and episode integrity; a tail file alone is not reported as a complete recording.",
