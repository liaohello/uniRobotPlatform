        },
        "422": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          },
          "description": "Validation Error"
        }
      },
      "summary": "Stop and reliably finalize the recording segment this Session began"
    },
    "/api/v1/sessions/{session_id}/stop": {
      "description": "Sends the native latched STOP inside the lifecycle critical section and returns dispatch, parking and coverage evidence separately. It is not POST /api/v1/runs/{run_id}/stop, it never RESETs, never clears the safety latch and never ends the recording.",
      "operationId": "stop_session_api_v1_sessions__session_id__stop_post",
      "parameters": [
        {
          "in": "path",
          "name": "session_id",
          "required": true,
