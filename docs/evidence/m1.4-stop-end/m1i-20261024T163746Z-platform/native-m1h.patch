+            episode_complete_sha256=finalized.get("episode_complete_sha256") if finalized else None,
+            checksummed_artifacts=finalized.get("checksummed_artifacts", 0) if finalized else 0,
+            preserved_records=finalized is not None or after is not None,
+        )
+        if finalized is None:
+            integrity = (
