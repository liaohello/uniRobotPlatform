+            safety_latched=bool(parked.safety_latched),
+            recording_status=after.status if after is not None else RecordingStatus.IDLE,
+            recording_segment_id=after.recording_segment_id if after is not None else None,
+        )
+        self._remember(self.stop_receipts, request.request_id, receipt)
+        self.broadcast({"type": "state", "data": {"session_stop": receipt.model_dump(mode="json")}})
+        return receipt
+
+    def end_recording(self, request: RecordingEndRequest) -> RecordingEndResponse:
+        """Identity-bound STOP plus Recorder drain/finalize for one known segment."""
+        with self.lifecycle_lock:
+            return self._end_recording_locked(request)
+
+    def _end_recording_locked(self, request: RecordingEndRequest) -> RecordingEndResponse:
+        remembered = self.end_receipts.get(request.request_id)
+        if remembered is not None:
+            replayed = remembered.model_copy(update={"replayed": True})
+            self.end_receipts.move_to_end(request.request_id)
+            return replayed
+        snapshot = self.backend.snapshot()
+        observed = (snapshot.run_id, snapshot.backend_generation, snapshot.episode_id)
+        requested = (request.run_id, request.backend_generation, request.episode_id)
+        state = self.recording_state()
+        active_segment = state.recording_segment_id if state is not None else None
+        live_status = state.status if state is not None else RecordingStatus.IDLE
+        identity = {
+            "request_id": request.request_id,
+            "binding_id": request.binding_id,
+            "session_id": request.session_id,
+            "config_fingerprint": request.config_fingerprint,
+            "run_id": observed[0],
+            "backend_generation": observed[1],
+            "episode_id": observed[2],
