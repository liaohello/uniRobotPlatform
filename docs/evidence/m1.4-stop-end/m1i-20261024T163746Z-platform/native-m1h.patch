+def test_recording_begin_requires_a_started_binding_and_matching_config(client):
+    http, _, _ = client
+    prepared = _prepare(http)
+    not_started = _begin(http, prepared)
+    assert not_started["accepted"] is False
+    assert "prepared" in not_started["reason"]
+    assert _start(http, prepared)["started"] is True
+    wrong_config = _begin(http, prepared, config_fingerprint="cs-" + "c" * 40)
