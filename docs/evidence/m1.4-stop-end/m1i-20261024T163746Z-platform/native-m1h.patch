+        identity: dict[str, Any],
+        binding_state: str,
+        finalized: dict[str, Any],
+        *,
+        live_status: RecordingStatus,
+        safety_latched: bool,
+    ) -> RecordingEndResponse:
+        complete = str(finalized.get("audit_status")) == "COMPLETE"
+        return RecordingEndResponse(
+            **identity,
+            accepted=True,
+            code="end_already_finalized",
+            reason=(
+                "this segment is already finalized on disk; no second STOP, drain or tail "
+                "record was made"
+            ),
+            binding_state=binding_state,
+            integrity="complete" if complete else "incomplete_terminal_recorded",
+            recording_status=live_status,
+            safety_latched=safety_latched,
+            finalize=RecordingFinalizeEvidence(
+                completed=True,
+                terminal_event_written=True,
+                complete_tail=True,
+                recording_status=str(finalized.get("recording_status", "UNKNOWN")),
+                audit_status=str(finalized.get("audit_status", "UNKNOWN")),
+                event_count=finalized.get("event_count"),
+                dropped_events=finalized.get("dropped_events"),
+                storage_ref=finalized.get("storage_ref"),
+                episode_complete_sha256=finalized.get("episode_complete_sha256"),
+                checksummed_artifacts=finalized.get("checksummed_artifacts", 0),
+                preserved_records=True,
