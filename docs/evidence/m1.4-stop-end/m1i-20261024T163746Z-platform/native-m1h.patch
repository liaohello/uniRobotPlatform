+            reason = parking.coverage_note
+        else:
+            accepted, code, reason = True, "ended", ""
+        receipt = RecordingEndResponse(
+            **{
+                **identity,
+                "active_segment_id": after.recording_segment_id if after is not None else None,
+            },
+            accepted=accepted,
+            code=code,
+            reason=reason,
+            binding_state=record.state,
+            dispatch=dispatch,
+            parking=parking,
+            drain=drain,
+            finalize=finalize,
+            integrity=integrity,
+            recording_status=after.status if after is not None else RecordingStatus.IDLE,
+            safety_latched=bool(final_snapshot.safety_latched),
+        )
+        self._remember(self.end_receipts, request.request_id, receipt)
+        return receipt
+
+    def _end_receipt_from_disk(
