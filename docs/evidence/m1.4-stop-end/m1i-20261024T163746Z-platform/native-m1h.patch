+            error=finalize_error,
+            terminal_event_written=finalized is not None,
+            complete_tail=finalized is not None,
+            recording_status=str(finalized["recording_status"]) if finalized else "UNKNOWN",
+            audit_status=str(finalized["audit_status"]) if finalized else "UNKNOWN",
+            event_count=finalized.get("event_count") if finalized else None,
+            dropped_events=dropped,
