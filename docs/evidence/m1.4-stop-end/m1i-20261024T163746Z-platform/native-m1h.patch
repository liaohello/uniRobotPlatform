+            )
+        elif finalize.audit_status == "COMPLETE" and finalize_error is None:
+            integrity = "complete"
+        else:
+            integrity = "incomplete_terminal_recorded"
+        if finalized is None:
+            accepted, code = False, "end_finalize_failed"
+            reason = finalize_error or "the Recorder did not write a terminal record"
+        elif not dispatch.dispatched:
