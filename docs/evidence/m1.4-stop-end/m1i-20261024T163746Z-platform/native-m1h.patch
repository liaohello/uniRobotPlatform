+def test_start_refuses_a_tampered_binding(client):
+    http, app, _ = client
+    prepared = _prepare(http)
+    record = app.state.mobilecar.session_bindings._records[prepared["binding_id"]]
+    record.config_fingerprint = "0" * 64
