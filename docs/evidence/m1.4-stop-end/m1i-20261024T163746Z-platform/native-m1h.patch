+        parking, parked = self._wait_parking_locked(request.parking_timeout_s)
+        after = self.recording_state()
+        if not dispatch.dispatched:
+            code, reason = "stop_dispatch_failed", "the backend did not accept the STOP command"
+        elif not parking.confirmed:
+            code, reason = (
