diff --git a/src/mobilecar/session_binding.py b/src/mobilecar/session_binding.py
new file mode 100644
index 0000000..279f7ce
--- /dev/null
+++ b/src/mobilecar/session_binding.py
@@ -0,0 +1,262 @@
+"""Motion-free Session bindings shared by every native backend.
+
+A binding records that this exact run/generation/episode may be started by a
+platform Session. It never acquires a control owner, sends a command, resets an
+Episode or starts a recording. Callers must hold the backend lock so prepare,
+start and RESET cannot interleave.
+"""
+
+from __future__ import annotations
+
+import time
+from dataclasses import dataclass, field
+from typing import Callable
+from uuid import uuid4
+
+from .contracts.models import (
+    SessionBindingPrepareRequest,
+    SessionBindingView,
+)
+
+PROTOCOL = "m1-binding-1"
+CONTROL_SCOPE = ["base", "arm", "gripper"]
+MAX_RECORDS = 64
+
+
+class BindingRefused(RuntimeError):
+    def __init__(self, code: str, reason: str) -> None:
+        super().__init__(reason)
+        self.code = code
+        self.reason = reason
+
+
+@dataclass
+class MotionContext:
+    recording_required_for_motion: bool
+    recording_begin_required: bool
+    recording_ready: bool
+    safety_latched: bool
+    base_owner_session_id: str | None
+    arm_owner_session_id: str | None
+
+
+@dataclass
+class BindingRecord:
+    binding_id: str
+    session_id: str
+    config_fingerprint: str
+    run_id: str
+    backend_generation: int
+    episode_id: str
+    created_at: float
+    expires_at: float
+    state: str = "prepared"
+    reason: str = ""
+    started_at: float | None = None
+    control_scope_granted: list[str] = field(default_factory=list)
+    owner_state: str = "not_acquired"
+    owner_session_id: str | None = None
+    lease_expires_at: float | None = None
+    recording_required_for_motion: bool = True
+    recording_begin_required: bool = True
+    recording_ready: bool = False
+    motion_ready: bool = False
+    motion_blockers: list[str] = field(default_factory=list)
+
+    @property
+    def identity(self) -> tuple[str, int, str]:
+        return (self.run_id, self.backend_generation, self.episode_id)
+
+
+class SessionBindingRegistry:
+    def __init__(
+        self,
+        *,
+        ttl_s: float = 30.0,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        if ttl_s <= 0:
+            raise ValueError("binding TTL must be positive")
+        self.ttl_s = float(ttl_s)
+        self.clock = clock
+        self._records: dict[str, BindingRecord] = {}
+
+    def _evaluate(self, record: BindingRecord, identity: tuple[str, int, str]) -> None:
+        if record.state not in {"prepared", "started"}:
+            return
+        if record.identity != identity:
+            record.state = "invalidated"
+            record.reason = "native runtime identity changed after prepare"
+            return
+        # The prepare TTL only bounds the period in which a prepared binding may
+        # become started. A started Session remains valid until RESET, release
+        # or a future explicit Session end.
+        if record.state == "prepared" and self.clock() >= record.expires_at:
+            record.state = "expired"
+            record.reason = "prepared binding expired before start"
+
+    def _evict(self) -> None:
+        if len(self._records) <= MAX_RECORDS:
+            return
+        terminal = [
+            key for key, value in self._records.items()
+            if value.state in {"expired", "invalidated", "released"}
+        ]
+        for key in terminal[: max(0, len(self._records) - MAX_RECORDS)]:
+            self._records.pop(key, None)
+
+    def prepare(
+        self,
+        request: SessionBindingPrepareRequest,
+        identity: tuple[str, int, str],
+        context: MotionContext,
+    ) -> BindingRecord:
+        requested = (
+            request.run_id,
+            request.backend_generation,
+            request.episode_id,
+        )
+        if requested != identity:
+            raise BindingRefused(
+                "runtime_identity_mismatch",
+                "request identity does not match the live run/generation/episode",
+            )
+        for record in self._records.values():
+            self._evaluate(record, identity)
+            if record.identity == identity and record.state in {"prepared", "started"}:
+                raise BindingRefused(
+                    "binding_conflict",
+                    f"runtime already has binding {record.binding_id} in state {record.state}",
+                )
+        now = self.clock()
+        record = BindingRecord(
+            binding_id=f"bind_{uuid4().hex}",
+            session_id=request.session_id,
+            config_fingerprint=request.config_fingerprint,
+            run_id=request.run_id,
+            backend_generation=request.backend_generation,
+            episode_id=request.episode_id,
+            created_at=now,
+            expires_at=now + self.ttl_s,
+        )
+        self._apply_context(record, context)
+        self._records[record.binding_id] = record
+        self._evict()
+        return record
+
+    def get(
+        self,
+        binding_id: str,
+        identity: tuple[str, int, str],
+        context: MotionContext | None = None,
+    ) -> BindingRecord | None:
+        record = self._records.get(binding_id)
+        if record is None:
+            return None
+        self._evaluate(record, identity)
+        if context is not None and record.state in {"prepared", "started"}:
+            self._apply_context(record, context)
+        return record
+
+    def start(
+        self,
+        binding_id: str,
+        *,
+        session_id: str,
+        config_fingerprint: str,
+        identity: tuple[str, int, str],
+        context: MotionContext,
+    ) -> BindingRecord:
+        record = self.get(binding_id, identity, context)
+        if record is None:
+            raise BindingRefused("binding_not_found", "binding is unknown or was released")
+        if record.session_id != session_id:
+            raise BindingRefused("binding_session_mismatch", "session_id does not match the binding")
+        if record.config_fingerprint != config_fingerprint:
+            raise BindingRefused(
+                "binding_config_mismatch", "config_fingerprint does not match the binding"
+            )
+        if record.state == "started":
+            return record
+        if record.state != "prepared":
+            raise BindingRefused(
+                f"binding_{record.state}",
+                record.reason or f"binding is {record.state} and cannot start",
+            )
+        record.state = "started"
+        record.started_at = self.clock()
+        record.control_scope_granted = list(CONTROL_SCOPE)
+        self._apply_context(record, context)
+        return record
+
+    def release(self, binding_id: str) -> bool:
+        record = self._records.get(binding_id)
+        if record is None or record.state not in {"prepared", "started"}:
+            return False
+        record.state = "released"
+        record.reason = "released by the platform"
+        return True
+
+    def invalidate_all(self, reason: str) -> None:
+        for record in self._records.values():
+            if record.state in {"prepared", "started"}:
+                record.state = "invalidated"
+                record.reason = reason
+
+    def _apply_context(self, record: BindingRecord, context: MotionContext) -> None:
+        record.recording_required_for_motion = context.recording_required_for_motion
+        record.recording_begin_required = context.recording_begin_required
+        record.recording_ready = context.recording_ready
+        owners = [
+            owner for owner in (
+                context.base_owner_session_id,
+                context.arm_owner_session_id,
+            ) if owner
+        ]
+        foreign = [owner for owner in owners if owner != record.session_id]
+        if owners:
+            record.owner_state = "held"
+            record.owner_session_id = foreign[0] if foreign else owners[0]
+        else:
+            record.owner_state = "not_acquired"
+            record.owner_session_id = None
+        # Native exposes no lease deadline in its snapshot; null is "not exposed",
+        # not an invented expiry.
+        record.lease_expires_at = None
+        blockers: list[str] = []
+        if record.state != "started":
+            blockers.append("binding_not_started")
+        if context.recording_required_for_motion and not context.recording_ready:
+            blockers.append("recording_not_ready")
+        if context.safety_latched:
+            blockers.append("safety_latched")
+        if foreign:
+            blockers.append("control_owner_present")
+        record.motion_blockers = blockers
+        record.motion_ready = not blockers
+
+    def view(self, record: BindingRecord, *, accepted: bool = True, reason: str = "") -> SessionBindingView:
+        return SessionBindingView(
+            accepted=accepted,
+            reason=reason or record.reason,
+            binding_id=record.binding_id,
+            session_id=record.session_id,
+            config_fingerprint=record.config_fingerprint,
+            run_id=record.run_id,
+            backend_generation=record.backend_generation,
+            episode_id=record.episode_id,
+            state=record.state,
+            motion_commands_accepted=False,
+            created_at_backend_monotonic_s=record.created_at,
+            expires_at_backend_monotonic_s=record.expires_at,
+            started_at_backend_monotonic_s=record.started_at,
+            control_scope_granted=list(record.control_scope_granted),
+            owner_state=record.owner_state,
+            owner_session_id=record.owner_session_id,
+            lease_expires_at_backend_monotonic_s=record.lease_expires_at,
+            recording_required_for_motion=record.recording_required_for_motion,
+            recording_begin_required=record.recording_begin_required,
+            recording_ready=record.recording_ready,
+            motion_ready=record.motion_ready,
+            motion_blockers=list(record.motion_blockers),
+        )
diff --git a/tests/integration/test_lifecycle_race.py b/tests/integration/test_lifecycle_race.py
new file mode 100644
index 0000000..d412165
--- /dev/null
+++ b/tests/integration/test_lifecycle_race.py
@@ -0,0 +1,235 @@
+"""Deterministic RESET / legacy start / new begin mutual exclusion.
+
+A barrier blocks the first recorder.start while it holds the lifecycle and
+backend locks.  Competing RESET or episodes/start calls must wait and then
+observe the active recording instead of submitting a stale RESET.
+"""
+
+from __future__ import annotations
+
+import copy
+import threading
+import time
+from pathlib import Path
+
+import pytest
+import yaml
+from fastapi.testclient import TestClient
+
+from mobilecar.app import create_app
+from mobilecar.config import load_config
+from mobilecar.contracts import (
+    CommandRequest,
+    CommandType,
+    EpisodeStartRequest,
+    OperatorKind,
+    RecordingBeginRequest,
+)
+
+
+def _profile(tmp_path: Path) -> Path:
+    base = load_config()
+    data = copy.deepcopy(base.data)
+    data["backend"]["kind"] = "mock"
+    data["recording"]["required_for_motion"] = True
+    data["recording"]["root"] = str(tmp_path / "runs")
+    data["quality"]["report_root"] = str(tmp_path / "reports")
+    path = tmp_path / "config.yaml"
+    path.write_text(yaml.safe_dump(data, sort_keys=False), encoding="utf-8")
+    return path
+
+
+@pytest.fixture()
+def app(tmp_path):
+    application = create_app(_profile(tmp_path))
+    with TestClient(application) as http:
+        yield application, http, tmp_path
+
+
+def _identity(http) -> dict:
+    health = http.get("/api/v1/health").json()
+    return {
+        "run_id": health["run_id"],
+        "backend_generation": health["backend_generation"],
+        "episode_id": health["episode_id"],
+    }
+
+
+def _prepared(http, *, session_id: str) -> dict:
+    response = http.post(
+        "/api/v1/session/prepare",
+        json={
+            "contract_version": "mobilecar-1.0",
+            "session_id": session_id,
+            "config_fingerprint": "cs-" + "e" * 40,
+            **_identity(http),
+        },
+    )
+    assert response.status_code == 200, response.text
+    payload = response.json()
+    assert payload["accepted"] is True
+    return payload
+
+
+def _start(http, prepared: dict) -> None:
+    started = http.post(
+        "/api/v1/session/start",
+        json={
+            "binding_id": prepared["binding_id"],
+            "session_id": prepared["session_id"],
+            "config_fingerprint": prepared["config_fingerprint"],
+        },
+    ).json()
+    assert started["started"] is True, started
+
+
+def _reset_request(runtime) -> CommandRequest:
+    snapshot = runtime.backend.snapshot()
+    return CommandRequest(
+        contract_version="mobilecar-1.0",
+        run_id=snapshot.run_id,
+        backend_generation=snapshot.backend_generation,
+        episode_id=snapshot.episode_id,
+        session_id="race-reset",
+        operator_id="race-reset",
+        operator_kind=OperatorKind.SCRIPTED,
+        view_source="race_fixture",
+        command_id="race-reset-1",
+        command_seq=1,
+        command_type=CommandType.RESET,
+        requested_ttl_s=1.0,
+        payload={"confirm": True},
+    )
+
+
+def _begin_request(prepared: dict) -> RecordingBeginRequest:
+    return RecordingBeginRequest(
+        binding_id=prepared["binding_id"],
+        session_id=prepared["session_id"],
+        config_fingerprint=prepared["config_fingerprint"],
+        operator_id="race-human",
+        operator_kind=OperatorKind.HUMAN_TELEOP,
+        view_source="third_person_3d",
+    )
+
+
+def _barrier_start(runtime):
+    entered = threading.Event()
+    release = threading.Event()
+    calls: list[int] = []
+    original = runtime.recorder.start
+
+    def blocking_start(request, snapshot):
+        calls.append(1)
+        entered.set()
+        assert release.wait(10.0), "test barrier timed out"
+        return original(request, snapshot)
+
+    runtime.recorder.start = blocking_start
+    return entered, release, calls
+
+
+def test_reset_and_legacy_start_cannot_pierce_an_active_begin(app):
+    application, http, _ = app
+    runtime = application.state.mobilecar
+    prepared = _prepared(http, session_id="ps-race-begin")
+    _start(http, prepared)
+    submitted: list[tuple[str, str]] = []
+    original_submit = runtime.backend.submit
+
+    def spy_submit(request):
+        submitted.append((str(request.command_type), runtime.recorder.status().status))
+        return original_submit(request)
+
+    runtime.backend.submit = spy_submit
+    entered, release, start_calls = _barrier_start(runtime)
+
+    begin_result: dict = {}
+    reset_result: dict = {}
+    legacy_result: dict = {}
+
+    def run_begin() -> None:
+        begin_result["value"] = runtime.begin_recording(_begin_request(prepared))
+
+    def run_reset() -> None:
+        reset_result["value"] = runtime.submit(_reset_request(runtime))
+
+    def run_legacy() -> None:
+        legacy_result["value"] = runtime.start_episode(
+            EpisodeStartRequest(
+                operator_id="legacy-race",
+                operator_kind=OperatorKind.SCRIPTED,
+                view_source="race_fixture",
+                require_recording=True,
+            )
+        )
+
+    threads = [
+        threading.Thread(target=run_begin, name="race-begin"),
+        threading.Thread(target=run_reset, name="race-reset"),
+        threading.Thread(target=run_legacy, name="race-legacy-start"),
+    ]
+    threads[0].start()
+    assert entered.wait(5.0), "begin did not reach the recorder barrier"
+    threads[1].start()
+    threads[2].start()
+    time.sleep(0.25)
+    assert threads[1].is_alive() and threads[2].is_alive()
+    assert submitted == []
+    release.set()
+    for thread in threads:
+        thread.join(timeout=10.0)
+        assert not thread.is_alive()
+
+    assert begin_result["value"].accepted is True
+    assert begin_result["value"].recording_status == "RECORDING"
+    assert reset_result["value"].status == "REJECTED"
+    assert "stop the active recording" in reset_result["value"].reason
+    assert legacy_result["value"].accepted is False
+    assert "already RECORDING" in legacy_result["value"].reason
+    assert start_calls == [1]
+    assert submitted == []
+    assert runtime.recording_state().status == "RECORDING"
+    binding = runtime.read_session_binding(prepared["binding_id"])
+    assert binding is not None and binding.state == "started"
+
+
+def test_begin_cannot_interleave_with_a_legacy_episode_start(app):
+    application, http, _ = app
+    runtime = application.state.mobilecar
+    prepared = _prepared(http, session_id="ps-race-legacy")
+    _start(http, prepared)
+    entered, release, start_calls = _barrier_start(runtime)
+    legacy_result: dict = {}
+    begin_result: dict = {}
+
+    def run_legacy() -> None:
+        legacy_result["value"] = runtime.start_episode(
+            EpisodeStartRequest(
+                operator_id="legacy-race",
+                operator_kind=OperatorKind.SCRIPTED,
+                view_source="race_fixture",
+                require_recording=True,
+            )
+        )
+
+    def run_begin() -> None:
+        begin_result["value"] = runtime.begin_recording(_begin_request(prepared))
+
+    legacy = threading.Thread(target=run_legacy, name="race-legacy-start")
+    begin = threading.Thread(target=run_begin, name="race-begin")
+    legacy.start()
+    assert entered.wait(5.0), "legacy start did not reach the recorder barrier"
+    begin.start()
+    time.sleep(0.25)
+    assert begin.is_alive()
+    release.set()
+    legacy.join(timeout=10.0)
+    begin.join(timeout=10.0)
+    assert not legacy.is_alive() and not begin.is_alive()
+
+    assert legacy_result["value"].accepted is True
+    assert start_calls == [1]
+    assert begin_result["value"].accepted is False
+    assert "invalidated" in begin_result["value"].reason
+    assert runtime.recording_state().status == "RECORDING"
diff --git a/tests/integration/test_recording_end.py b/tests/integration/test_recording_end.py
new file mode 100644
index 0000000..3553c2b
--- /dev/null
+++ b/tests/integration/test_recording_end.py
@@ -0,0 +1,414 @@
+"""Identity-bound robot STOP and reliable recording end.
+
+The mock backend is clearly labelled; the Recorder, its queue, its events file
+and its finalize artifacts are the real ones, so tail records and integrity
+conclusions are observed from disk rather than asserted from a flag.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import threading
+import time
+from pathlib import Path
+
+import pytest
+import yaml
+from fastapi.testclient import TestClient
+
+from mobilecar.app import create_app
+from mobilecar.config import load_config
+from mobilecar.contracts import CommandResponse, CommandStatus, CommandType
+
+
+FINGERPRINT = "cs-" + "d" * 40
+
+
+def _profile(tmp_path: Path) -> Path:
+    base = load_config()
+    data = copy.deepcopy(base.data)
+    data["backend"]["kind"] = "mock"
+    data["recording"]["required_for_motion"] = True
+    data["recording"]["root"] = str(tmp_path / "runs")
+    data["quality"]["report_root"] = str(tmp_path / "reports")
+    path = tmp_path / "config.yaml"
+    path.write_text(yaml.safe_dump(data, sort_keys=False), encoding="utf-8")
+    return path
+
+
+@pytest.fixture()
+def app(tmp_path):
+    application = create_app(_profile(tmp_path))
+    with TestClient(application) as http:
+        yield application, http, tmp_path
+
+
+def _identity(http) -> dict:
+    health = http.get("/api/v1/health").json()
+    return {
+        "run_id": health["run_id"],
+        "backend_generation": health["backend_generation"],
+        "episode_id": health["episode_id"],
+    }
+
+
+def _session(http, *, session_id: str) -> dict:
+    identity = _identity(http)
+    prepared = http.post("/api/v1/session/prepare", json={
+        "contract_version": "mobilecar-1.0", "session_id": session_id,
+        "config_fingerprint": FINGERPRINT, **identity,
+    }).json()
+    assert prepared["accepted"] is True, prepared
+    started = http.post("/api/v1/session/start", json={
+        "binding_id": prepared["binding_id"], "session_id": session_id,
+        "config_fingerprint": FINGERPRINT,
+    }).json()
+    assert started["started"] is True, started
+    return {**prepared, "identity": identity}
+
+
+def _begin(http, session: dict, *, operator: str = "end-human") -> dict:
+    response = http.post("/api/v1/recording/begin", json={
+        "contract_version": "mobilecar-1.0", "binding_id": session["binding_id"],
+        "session_id": session["session_id"], "config_fingerprint": FINGERPRINT,
+        "operator_id": operator, "operator_kind": "human_teleop",
+        "view_source": "third_person_3d",
+    })
+    payload = response.json()
+    assert response.status_code == 200 and payload["accepted"] is True, payload
+    return payload
+
+
+def _end(http, session: dict, *, segment: str, request_id: str, reason: str = "OPERATOR_FINISHED",
+         **overrides) -> dict:
+    body = {
+        "contract_version": "mobilecar-1.0", "request_id": request_id,
+        "binding_id": session["binding_id"], "session_id": session["session_id"],
+        "config_fingerprint": FINGERPRINT, **session["identity"],
+        "recording_segment_id": segment, "reason": reason,
+    }
+    body.update(overrides)
+    response = http.post("/api/v1/recording/end", json=body)
+    assert response.status_code == 200, response.text
+    return response.json()
+
+
+def _stop(http, session: dict, *, request_id: str, **overrides) -> dict:
+    body = {
+        "contract_version": "mobilecar-1.0", "request_id": request_id,
+        "binding_id": session["binding_id"], "session_id": session["session_id"],
+        "config_fingerprint": FINGERPRINT, **session["identity"], "reason": "SESSION_STOP",
+    }
+    body.update(overrides)
+    response = http.post("/api/v1/session/stop", json=body)
+    assert response.status_code == 200, response.text
+    return response.json()
+
+
+def _episode_files(tmp_path: Path, run_id: str, episode_id: str) -> tuple[Path, Path]:
+    root = tmp_path / "runs" / run_id / "episodes" / episode_id
+    return root / "events.jsonl", root / "episode_complete.json"
+
+
+def _terminal_events(events_path: Path) -> list[dict]:
+    if not events_path.is_file():
+        return []
+    return [
+        json.loads(line) for line in events_path.read_text(encoding="utf-8").splitlines()
+        if json.loads(line).get("event_type") == "episode_terminal"
+    ]
+
+
+def test_capabilities_declare_stop_and_end_protocols(app):
+    application, http, _ = app
+    capabilities = http.get("/api/v1/capabilities").json()
+    assert capabilities["session_stop_protocol"] == "m1-stop-1"
+    assert capabilities["recording_end_protocol"] == "m1-end-1"
+    attestation = http.get("/api/v1/attestation").json()
+    assert attestation["protocols"]["session_stop"] == "m1-stop-1"
+    assert attestation["protocols"]["recording_end"] == "m1-end-1"
+    assert hasattr(application.state.mobilecar, "stop_receipts")
+
+
+def test_session_stop_is_identity_bound_and_leaves_recording_untouched(app):
+    application, http, _ = app
+    runtime = application.state.mobilecar
+    session = _session(http, session_id="ps-stop-only")
+    begun = _begin(http, session)
+    submitted: list[CommandType] = []
+    original_submit = runtime.backend.submit
+
+    def spy(request):
+        submitted.append(CommandType(request.command_type))
+        return original_submit(request)
+
+    runtime.backend.submit = spy
+    refused = _stop(http, session, request_id="stop-bad-identity", episode_id="episode-other")
+    assert refused["accepted"] is False
+    assert refused["code"] == "stop_runtime_identity_mismatch"
+    assert refused["dispatch"]["dispatched"] is False
+    assert submitted == []
+
+    stopped = _stop(http, session, request_id="stop-live-identity")
+    assert stopped["accepted"] is True, stopped
+    assert stopped["code"] == "stopped"
+    assert stopped["dispatch"]["dispatched"] is True
+    assert stopped["dispatch"]["status"] == "DISPATCHED"
+    assert stopped["parking"]["confirmed"] is True
+    assert stopped["parking"]["observed_confirmed"] is True
+    assert stopped["recording_touched"] is False
+    assert stopped["motion_restored"] is False
+    # The stop is not a RESET and does not end the recording: the segment stays live.
+    assert runtime.recording_state().status == "RECORDING"
+    assert runtime.recording_state().recording_segment_id == begun["recording_segment_id"]
+    assert submitted == [CommandType.STOP]
+
+    replay = _stop(http, session, request_id="stop-live-identity")
+    assert replay["replayed"] is True and replay["dispatch"]["command_id"] == stopped["dispatch"]["command_id"]
+    assert submitted == [CommandType.STOP]
+
+
+def test_session_stop_needs_no_recording_or_owner_and_refuses_a_borrowed_binding(app):
+    application, http, _ = app
+    runtime = application.state.mobilecar
+    session = _session(http, session_id="ps-stop-no-recording")
+    # Recording is IDLE and no owner holds the robot; the safety STOP still works.
+    assert runtime.recording_state().status == "IDLE"
+    stopped = _stop(http, session, request_id="stop-idle")
+    assert stopped["accepted"] is True, stopped
+    assert stopped["recording_status"] == "IDLE"
+    assert stopped["owner_cleared_after_stop"] is True
+
+    borrowed = _stop(http, session, request_id="stop-borrowed", binding_id="binding-other")
+    assert borrowed["accepted"] is False and borrowed["code"] == "stop_binding_not_found"
+
+
+def test_recording_end_finalizes_once_and_replays_without_a_second_tail(app):
+    application, http, tmp_path = app
+    runtime = application.state.mobilecar
+    session = _session(http, session_id="ps-end-complete")
+    begun = _begin(http, session)
+    segment = begun["recording_segment_id"]
+
+    receipt = _end(http, session, segment=segment, request_id="end-1")
+    assert receipt["accepted"] is True, receipt
+    assert receipt["code"] == "ended"
+    assert receipt["protocol"] == "m1-end-1"
+    assert receipt["dispatch"]["dispatched"] is True
+    assert receipt["parking"]["confirmed"] is True
+    assert receipt["parking"]["coverage_complete"] is False
+    assert receipt["parking"]["scope_coverage"]["gripper"] == "not_observed"
+    assert receipt["drain"]["completed"] is True, receipt["drain"]
+    assert receipt["finalize"]["completed"] is True
+    assert receipt["finalize"]["complete_tail"] is True
+    assert receipt["integrity"] == "complete"
+    assert receipt["reset_issued"] is False and receipt["safety_cleared"] is False
+    assert receipt["recording_status"] == "COMPLETE"
+
+    events_path, complete_path = _episode_files(tmp_path, session["identity"]["run_id"],
+                                                session["identity"]["episode_id"])
+    terminals = _terminal_events(events_path)
+    assert len(terminals) == 1
+    assert terminals[0]["payload"]["recording_segment_id"] == segment
+    complete = json.loads(complete_path.read_text(encoding="utf-8"))
+    assert complete["recording_segment_id"] == segment
+    assert complete["audit_status"] == "COMPLETE"
+    assert receipt["finalize"]["episode_complete_sha256"] == hashlib.sha256(
+        complete_path.read_bytes()).hexdigest()
+    assert receipt["finalize"]["storage_ref"].endswith(session["identity"]["episode_id"])
+    assert receipt["finalize"]["checksummed_artifacts"] == len(complete["checksums"])
+    # The binding stays started: ending the recording is not a Session release.
+    binding = runtime.read_session_binding(session["binding_id"])
+    assert binding is not None and binding.state == "started"
+
+    same = _end(http, session, segment=segment, request_id="end-1")
+    assert same["replayed"] is True
+    stale = _end(http, session, segment=segment, request_id="end-2")
+    assert stale["code"] == "end_already_finalized" and stale["replayed"] is False
+    assert stale["integrity"] == "complete"
+    assert stale["dispatch"]["dispatched"] is False
+    assert stale["finalize"]["episode_complete_sha256"] == receipt["finalize"]["episode_complete_sha256"]
+    assert len(_terminal_events(events_path)) == 1
+
+
+def test_end_protects_a_newer_or_unknown_segment_and_another_session(app):
+    application, http, tmp_path = app
+    runtime = application.state.mobilecar
+    session = _session(http, session_id="ps-end-newer")
+    first = _begin(http, session)
+    _end(http, session, segment=first["recording_segment_id"], request_id="end-first")
+    second = _begin(http, session, operator="end-human-2")
+    assert second["recording_segment_id"] != first["recording_segment_id"]
+
+    unknown = _end(http, session, segment="seg_999_missing", request_id="end-unknown")
+    assert unknown["accepted"] is False
+    assert unknown["code"] == "end_segment_mismatch"
+    assert unknown["dispatch"]["dispatched"] is False
+    assert unknown["active_segment_id"] == second["recording_segment_id"]
+    assert runtime.recording_state().status == "RECORDING"
+    assert runtime.recording_state().recording_segment_id == second["recording_segment_id"]
+
+    events_path, complete_path = _episode_files(tmp_path, session["identity"]["run_id"],
+                                               session["identity"]["episode_id"])
+    before = hashlib.sha256(complete_path.read_bytes()).hexdigest()
+    other = {"binding_id": "binding-other", "session_id": "ps-other", "identity": session["identity"]}
+    foreign = _end(http, other, segment=second["recording_segment_id"], request_id="end-foreign")
+    assert foreign["accepted"] is False and foreign["code"] == "end_binding_not_found"
+    assert runtime.recording_state().recording_segment_id == second["recording_segment_id"]
+    assert hashlib.sha256(complete_path.read_bytes()).hexdigest() == before
+    assert len(_terminal_events(events_path)) == 1
+
+
+def test_parking_timeout_and_finalize_failure_stay_separable(app):
+    application, http, tmp_path = app
+    runtime = application.state.mobilecar
+    session = _session(http, session_id="ps-end-parking")
+    begun = _begin(http, session)
+    original_snapshot = runtime.backend.snapshot
+
+    def never_stopped():
+        snapshot = original_snapshot()
+        return snapshot.model_copy(update={"base": snapshot.base.model_copy(update={"stopped": False})})
+
+    runtime.backend.snapshot = never_stopped
+    try:
+        receipt = _end(http, session, segment=begun["recording_segment_id"],
+                       request_id="end-timeout", parking_timeout_s=0.05)
+    finally:
+        runtime.backend.snapshot = original_snapshot
+
+    assert receipt["accepted"] is True
+    assert receipt["code"] == "ended_parking_unconfirmed"
+    assert receipt["parking"]["confirmed"] is False
+    assert receipt["parking"]["timeout_ms"] == 50
+    assert receipt["parking"]["base_stopped"] is False
+    assert receipt["finalize"]["complete_tail"] is True
+    assert receipt["integrity"] == "complete"
+
+    failed = application.state.mobilecar
+    original_finalize = failed.recorder._finalize_episode
+    def explode(*args, **kwargs):
+        raise RuntimeError("injected finalize failure")
+    failed.recorder._finalize_episode = explode
+    segment = _begin(http, session, operator="end-human-3")["recording_segment_id"]
+    broken = _end(http, session, segment=segment, request_id="end-broken")
+    failed.recorder._finalize_episode = original_finalize
+    assert broken["accepted"] is False
+    assert broken["code"] == "end_finalize_failed"
+    assert broken["integrity"] == "finalize_failed_missing_tail"
+    assert broken["finalize"]["completed"] is False
+    assert broken["finalize"]["complete_tail"] is False
+    assert "injected finalize failure" in broken["finalize"]["error"]
+    events_path, _ = _episode_files(tmp_path, session["identity"]["run_id"], session["identity"]["episode_id"])
+    assert len(_terminal_events(events_path)) == 1
+
+    repaired = _end(http, session, segment=segment, request_id="end-retry")
+    assert repaired["accepted"] is True, repaired
+    assert repaired["code"] == "ended_incomplete_terminal"
+    assert repaired["integrity"] == "incomplete_terminal_recorded"
+    assert repaired["finalize"]["audit_status"] == "INCOMPLETE"
+    assert repaired["finalize"]["complete_tail"] is True
+    assert "injected finalize failure" in repaired["finalize"]["error"]
+    assert len(_terminal_events(events_path)) == 2
+
+
+def test_unobserved_motion_scope_is_reported_not_assumed_stopped(app):
+    application, http, _ = app
+    runtime = application.state.mobilecar
+    session = _session(http, session_id="ps-partial-coverage")
+    begun = _begin(http, session)
+    original_snapshot = runtime.backend.snapshot
+
+    def arm_still_moving():
+        snapshot = original_snapshot()
+        arm = snapshot.arm.model_copy(update={"joint_velocities_rad_s": [0.0, 0.4, 0.0, 0.0, 0.0]})
+        return snapshot.model_copy(update={"arm": arm})
+
+    runtime.backend.snapshot = arm_still_moving
+    try:
+        stopped = _stop(http, session, request_id="stop-moving-arm")
+        receipt = _end(http, session, segment=begun["recording_segment_id"], request_id="end-moving-arm")
+    finally:
+        runtime.backend.snapshot = original_snapshot
+
+    assert stopped["code"] == "stopped_partial_coverage"
+    assert stopped["parking"]["observed_confirmed"] is False
+    assert stopped["parking"]["scope_coverage"]["arm"] == "unconfirmed"
+    assert receipt["code"] == "ended_partial_stop_coverage"
+    assert receipt["parking"]["base_stopped"] is True
+    assert receipt["integrity"] == "complete"
+    assert receipt["finalize"]["complete_tail"] is True
+    # The receipt separates "base feed says stopped" from "the whole robot is proven at rest".
+    assert receipt["parking"]["coverage_complete"] is False
+
+
+def test_a_refused_backend_stop_is_reported_separately_from_parking(app):
+    application, http, tmp_path = app
+    runtime = application.state.mobilecar
+    session = _session(http, session_id="ps-refused-stop")
+    begun = _begin(http, session)
+    original_submit = runtime.backend.submit
+
+    def refuse(request):
+        if CommandType(request.command_type) is CommandType.STOP:
+            return CommandResponse(
+                command_id=request.command_id,
+                command_seq=request.command_seq,
+                status=CommandStatus.REJECTED,
+                reason="injected refusal",
+                backend_monotonic_s=runtime.backend.snapshot().backend_monotonic_s,
+                sim_time_s=runtime.backend.snapshot().sim_time_s,
+            )
+        return original_submit(request)
+
+    runtime.backend.submit = refuse
+    try:
+        stopped = _stop(http, session, request_id="stop-refused")
+        receipt = _end(http, session, segment=begun["recording_segment_id"], request_id="end-refused")
+    finally:
+        runtime.backend.submit = original_submit
+
+    assert stopped["accepted"] is False and stopped["code"] == "stop_dispatch_failed"
+    assert stopped["parking"]["confirmed"] is True
+    assert receipt["accepted"] is False and receipt["code"] == "end_dispatch_failed"
+    assert receipt["dispatch"]["status"] == CommandStatus.REJECTED.value
+    assert receipt["integrity"] == "complete"
+    events_path, _ = _episode_files(tmp_path, session["identity"]["run_id"], session["identity"]["episode_id"])
+    assert len(_terminal_events(events_path)) == 1
+
+
+def test_concurrent_end_of_one_segment_finalizes_exactly_once(app):
+    application, http, tmp_path = app
+    session = _session(http, session_id="ps-end-concurrent")
+    segment = _begin(http, session)["recording_segment_id"]
+    results: list[dict] = []
+    barrier = threading.Barrier(3)
+
+    def call(request_id: str) -> None:
+        barrier.wait(timeout=10.0)
+        results.append(_end(http, session, segment=segment, request_id=request_id))
+
+    threads = [
+        threading.Thread(target=call, args=("end-race-a",)),
+        threading.Thread(target=call, args=("end-race-b",)),
+    ]
+    for thread in threads:
+        thread.start()
+    barrier.wait(timeout=10.0)
+    for thread in threads:
+        thread.join(timeout=20.0)
+        assert not thread.is_alive()
+
+    events_path, complete_path = _episode_files(tmp_path, session["identity"]["run_id"],
+                                               session["identity"]["episode_id"])
+    assert len(_terminal_events(events_path)) == 1
+    digests = {item["finalize"]["episode_complete_sha256"] for item in results}
+    assert digests == {hashlib.sha256(complete_path.read_bytes()).hexdigest()}
+    assert {item["code"] for item in results} <= {
+        "ended", "ended_parking_unconfirmed", "end_already_finalized",
+    }
+    assert sum(1 for item in results if item["dispatch"]["dispatched"]) == 1
+    assert all(item["recording_segment_id"] == segment for item in results)
+    assert application.state.mobilecar.recording_state().status == "COMPLETE"
