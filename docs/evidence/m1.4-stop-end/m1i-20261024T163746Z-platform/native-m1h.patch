diff --git a/src/mobilecar/attestation.py b/src/mobilecar/attestation.py
new file mode 100644
index 0000000..c061e11
--- /dev/null
+++ b/src/mobilecar/attestation.py
@@ -0,0 +1,242 @@
+"""Deterministic deployment/config and compiled-scene attestations.
+
+The platform compares these digests with values pinned from the same source
+tree. They prove the effective configuration and compiled scene the process is
+actually using; they do not prove the source Git commit or installed packages
+by themselves.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import platform
+from importlib import metadata
+from pathlib import Path
+from typing import Any
+
+from .config import AppConfig, REPO_ROOT
+
+CONFIG_MANIFEST_SCHEMA = "mobilecar-config-manifest-1"
+RUNTIME_PACKAGES = (
+    "fastapi",
+    "httpx",
+    "mujoco",
+    "numpy",
+    "pillow",
+    "pydantic",
+    "PyYAML",
+    "uvicorn",
+)
+
+
+def canonical(value: Any) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+
+
+def digest(value: Any) -> str:
+    return hashlib.sha256(canonical(value)).hexdigest()
+
+
+def file_digest(path: Path) -> str:
+    body = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            body.update(block)
+    return body.hexdigest()
+
+
+def _relative(path: Path) -> str:
+    resolved = path.resolve()
+    try:
+        return resolved.relative_to(REPO_ROOT.resolve()).as_posix()
+    except ValueError as exc:
+        raise ValueError(f"attestation input is outside the native source root: {resolved}") from exc
+
+
+def _entry(role: str, path: Path, *, required: bool = True) -> dict[str, Any] | None:
+    resolved = path if path.is_absolute() else REPO_ROOT / path
+    resolved = resolved.resolve()
+    if not resolved.is_file():
+        if required:
+            raise FileNotFoundError(f"attestation input missing: {resolved}")
+        return None
+    try:
+        relative = _relative(resolved)
+        external = False
+    except ValueError:
+        # Test scratch configs may live outside the source root. Mark them
+        # explicitly so a production manifest with an external input is visible.
+        relative = resolved.as_posix()
+        external = True
+    entry = {
+        "role": role,
+        "path": relative,
+        "sha256": file_digest(resolved),
+        "size_bytes": resolved.stat().st_size,
+    }
+    if external:
+        entry["external"] = True
+    return entry
+
+
+def runtime_files(config: AppConfig) -> list[dict[str, Any]]:
+    """Files whose bytes participate in the effective execution configuration.
+
+    The list mirrors what the MuJoCo/mock backends and the quality pipeline read
+    from the effective config. A configured-but-absent optional posture profile
+    is recorded as absent rather than silently omitted.
+    """
+    data = config.data
+    backend = data["backend"]
+    entries: list[dict[str, Any]] = []
+    observation = _entry(
+        "observation_profile",
+        REPO_ROOT / str(backend.get("observation_profile_path", "configs/profiles/g2a_rgbd_5hz.yaml")),
+    )
+    if observation:
+        entries.append(observation)
+    if bool(backend.get("g4a1", {}).get("enabled", False)):
+        action = _entry("action_profile", REPO_ROOT / str(backend["g4a1"]["action_profile_path"]))
+        if action:
+            entries.append(action)
+    navigation = data.get("navigation", {})
+    if bool(navigation.get("enabled", False)):
+        profile = _entry(
+            "navigation_profile",
+            REPO_ROOT / str(navigation.get("profile_path", "configs/profiles/g3a_navigation_v1.yaml")),
+        )
+        if profile:
+            entries.append(profile)
+    posture_value = backend.get("posture_profile_path")
+    if posture_value:
+        posture = _entry("posture_profile", REPO_ROOT / str(posture_value), required=False)
+        if posture is None:
+            entries.append({
+                "role": "posture_profile",
+                "path": str(posture_value),
+                "sha256": None,
+                "size_bytes": None,
+                "present": False,
+            })
+        else:
+            entries.append(posture)
+    model_path = Path(str(backend["model_path"]))
+    model_path = model_path if model_path.is_absolute() else REPO_ROOT / model_path
+    arm_spec = _entry("arm_spec", model_path.resolve().parent / "arm_spec.json")
+    if arm_spec:
+        entries.append(arm_spec)
+    quality = data.get("quality", {})
+    for role, key, default in (
+        ("quality_profile", "profile_path", "configs/profiles/g2a_rgbd_5hz.yaml"),
+        ("quality_action_profile", "action_profile_path", "configs/profiles/g2a_action_teleop_v1.yaml"),
+    ):
+        entry = _entry(role, REPO_ROOT / str(quality.get(key, default)), required=False)
+        if entry:
+            entries.append(entry)
+    unique: dict[str, dict[str, Any]] = {}
+    for entry in entries:
+        current = unique.get(entry["path"])
+        if current is None:
+            unique[entry["path"]] = entry
+        else:
+            roles = set(current["role"].split(",")) | {entry["role"]}
+            current["role"] = ",".join(sorted(roles))
+    return sorted(unique.values(), key=lambda item: item["path"])
+
+
+def runtime_environment() -> dict[str, Any]:
+    versions: dict[str, str] = {}
+    missing: list[str] = []
+    for name in RUNTIME_PACKAGES:
+        try:
+            versions[name] = metadata.version(name)
+        except metadata.PackageNotFoundError:
+            missing.append(name)
+    return {
+        "python": platform.python_version(),
+        "implementation": platform.python_implementation(),
+        "packages": versions,
+        "missing_packages": missing,
+    }
+
+
+def apply_launch_overrides(
+    data: dict[str, Any],
+    *,
+    backend_kind: str | None = None,
+    require_recording: bool | None = None,
+    realtime: bool | None = None,
+) -> dict[str, Any]:
+    result = json.loads(json.dumps(data))
+    if backend_kind is not None:
+        result["backend"]["kind"] = backend_kind
+    if require_recording is not None:
+        result["recording"]["required_for_motion"] = bool(require_recording)
+    if realtime is not None:
+        result["backend"]["realtime"] = bool(realtime)
+    return result
+
+
+def build_config_manifest(
+    config: AppConfig,
+    *,
+    backend_kind: str | None = None,
+    require_recording: bool | None = None,
+    realtime: bool | None = None,
+) -> dict[str, Any]:
+    config_files = [
+        _entry("config", path) for path in config.sources
+    ]
+    effective = apply_launch_overrides(
+        config.data,
+        backend_kind=backend_kind,
+        require_recording=require_recording,
+        realtime=realtime,
+    )
+    return {
+        "schema_version": CONFIG_MANIFEST_SCHEMA,
+        "config_files": sorted(
+            [entry for entry in config_files if entry], key=lambda item: item["path"]
+        ),
+        "runtime_files": runtime_files(config),
+        "effective_config": effective,
+        "launch_overrides": {
+            key: value
+            for key, value in (
+                ("backend_kind", backend_kind),
+                ("require_recording", require_recording),
+                ("realtime", realtime),
+            )
+            if value is not None
+        },
+    }
+
+
+def config_manifest_digest(manifest: dict[str, Any]) -> str:
+    return digest(manifest)
+
+
+def scene_manifest_digest(config: AppConfig) -> str:
+    """Compile the configured model and digest the served scene manifest.
+
+    This performs a model compile only: no MjData, physics step or renderer.
+    The backend must use the same model_id/scene_id derivation.
+    """
+    import mujoco
+
+    from .sensors.scene import build_scene_manifest
+
+    backend = config.data["backend"]
+    model_path = Path(str(backend["model_path"]))
+    model_path = model_path if model_path.is_absolute() else REPO_ROOT / model_path
+    model_path = model_path.resolve()
+    model_sha256 = file_digest(model_path)
+    model = mujoco.MjModel.from_xml_path(str(model_path))
+    manifest = build_scene_manifest(
+        model,
+        model_path,
+        model_id=f"landerpi_mecanum_dynamic_5dof_{model_sha256[:12]}",
+        scene_id=Path(str(backend.get("scene_path", "mobile_pick.xml"))).stem,
+    )
+    return digest(manifest.model_dump(mode="json"))
