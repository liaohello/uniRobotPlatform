+                "STOP was not confirmed by the observed motion feed; the robot is not reported as stopped",
+            )
+        elif not parking.observed_confirmed:
+            code, reason = "stopped_partial_coverage", parking.coverage_note
+        else:
+            code, reason = "stopped", ""
