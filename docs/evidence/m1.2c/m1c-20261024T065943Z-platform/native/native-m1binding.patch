+def test_recording_begin_persists_start_records_without_reset(client):
+    http, app, tmp_path = client
+    prepared = _prepare(http)
+    assert _start(http, prepared)["started"] is True
+    runtime = app.state.mobilecar
+    before = _identity(http)
+    before_snapshot = http.get("/api/v1/snapshot").json()
+    submitted = []
+    original = runtime.backend.submit
+
+    def spy(request):
+        submitted.append(request.command_type)
+        return original(request)
+
+    runtime.backend.submit = spy
+    begun = _begin(http, prepared)
+    assert begun["accepted"] is True, begun
+    assert begun["recording_status"] == "RECORDING"
+    assert begun["command_capture_ready"] is True
+    assert begun["durable_start_records"] is True
+    assert begun["recording_start_event_seq"] == 1
+    assert len(begun["initial_snapshot_sha256"]) == 64
+    assert begun["binding_id"] == prepared["binding_id"]
+    assert begun["session_id"] == prepared["session_id"]
+    assert submitted == []
+    assert _identity(http) == before
+
+    snapshot = http.get("/api/v1/snapshot").json()
+    assert snapshot["recording"]["status"] == "RECORDING"
+    assert snapshot["recording"]["command_capture_ready"] is True
+    assert snapshot["recording"]["recording_segment_id"] == begun["recording_segment_id"]
+    assert snapshot["base_owner_session_id"] is None
+    assert snapshot["arm_owner_session_id"] is None
+    assert snapshot["safety_latched"] == before_snapshot["safety_latched"]
+
+    episode_dir = (
+        tmp_path / "runs" / before["run_id"] / "episodes" / before["episode_id"]
+    )
+    initial = episode_dir / "initial_snapshot.json"
+    assert initial.is_file()
+    assert hashlib.sha256(initial.read_bytes()).hexdigest() == begun["initial_snapshot_sha256"]
+    events = [
+        json.loads(line)
+        for line in (episode_dir / "events.jsonl").read_text(encoding="utf-8").splitlines()
+    ]
+    assert events[0]["event_type"] == "recording_start"
+    assert events[0]["event_seq"] == 1
+    assert events[1]["event_type"] == "feedback_initial"
+    assert events[0]["payload"]["recording_segment_id"] == begun["recording_segment_id"]
+
+    readback = http.get(f"/api/v1/session/prepared/{prepared['binding_id']}").json()
+    assert readback["recording_ready"] is True
+    assert readback["motion_ready"] is True
+
+    repeated = _begin(http, prepared)
+    assert repeated["accepted"] is False
+    assert "already RECORDING" in repeated["reason"]
+    assert _identity(http) == before
